{
  "$schema": "https://raw.githubusercontent.com/nicehash/tauri/v2/crates/tauri-config-schema/schema.json",
  "productName": "git-client",
  "version": "0.1.0",
  "identifier": "com.yitao.git-client",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Git 客户端",
        "width": 1200,
        "height": 800,
        "minWidth": 1300,
        "minHeight": 640,
        "decorations": true,
        "resizable": true,
        "backgroundColor": "#1e1e1e"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFGMzM5QjcwNEQ4NjBBRDEKUldUUkNvWk5jSnN6SHlLSElDVWlxY1JhUVlWMmNDaExodzQrOUR2U0tNSVNBdG5Zb3R6dnU5bGUK",
      "endpoints": [
        "https://github.com/XiaMi-Long/git-client/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}